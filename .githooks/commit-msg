#!/bin/sh
# SysmlPlot commit-msg hook：检查提交信息格式（见 docs/DEVELOPMENT.md 1.2）。

msg_file=$1
if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
    exit 0
fi

subject=$(grep -v '^#' "$msg_file" | sed '/^[[:space:]]*$/d' | head -n 1)

# Git 自动生成的信息直接放行
case "$subject" in
    Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

if printf '%s' "$subject" | grep -Eq '^(feat|fix|docs|refactor|test|chore|build|perf|style|ci|revert)(\([A-Za-z0-9._/-]+\))?: .+'; then
    if [ "${#subject}" -gt 72 ]; then
        printf '\n[commit-msg] 标题过长（%d 字符 > 72），请精简：\n  %s\n\n' "${#subject}" "$subject"
        exit 1
    fi
    exit 0
fi

cat <<'EOF'

[commit-msg] 提交信息格式不符合规范。

要求：<type>(<scope>): <subject>
  type    feat | fix | docs | refactor | test | chore | build | perf | style | ci | revert
  scope   可选，建议写模块：parser | view | layout | render | samples | docs | hooks
  subject 一句话说明做了什么，不加句号，不超过 72 字符

示例：
  feat(view): 求值 expose 的递归形式
  fix(parser): 加载工作区时补齐标准库路径
  docs(env): 记录 Java 21 的位置与原因

详见 docs/DEVELOPMENT.md 1.2。

EOF
exit 1

